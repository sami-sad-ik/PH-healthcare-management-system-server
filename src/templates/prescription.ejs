<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Your Prescription</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Syne:wght@700;800&display=swap');

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background-color: #f0f4ff;
      font-family: 'Plus Jakarta Sans', sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .wrapper { max-width: 580px; margin: 0 auto; padding: 48px 20px; }

    .brand { text-align: center; margin-bottom: 28px; }
    .brand-logo { display: inline-flex; align-items: center; gap: 8px; }
    .brand-icon {
      width: 36px; height: 36px;
      background: linear-gradient(135deg, #0f3460, #16a085);
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
    }
    .brand-name {
      font-family: 'Syne', sans-serif;
      font-size: 18px; font-weight: 800;
      color: #0f3460; letter-spacing: -0.02em;
    }

    .card {
      background: #fff; border-radius: 24px; overflow: hidden;
      box-shadow: 0 4px 6px rgba(15,52,96,0.05), 0 20px 60px rgba(15,52,96,0.1);
    }

    .card-hero {
      background: linear-gradient(135deg, #0f3460 0%, #1a5f7a 50%, #16a085 100%);
      padding: 44px 48px 40px; position: relative; overflow: hidden;
    }
    .card-hero::before {
      content: ''; position: absolute; top: -40px; right: -40px;
      width: 220px; height: 220px; background: rgba(255,255,255,0.07); border-radius: 50%;
    }
    .card-hero::after {
      content: ''; position: absolute; bottom: -60px; left: -20px;
      width: 160px; height: 160px; background: rgba(255,255,255,0.05); border-radius: 50%;
    }
    .hero-tag {
      display: inline-flex; align-items: center; gap: 6px;
      background: rgba(255,255,255,0.18); border: 1px solid rgba(255,255,255,0.25);
      border-radius: 100px; padding: 5px 12px;
      font-size: 11px; font-weight: 600; color: #fff;
      letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 16px;
    }
    .hero-dot { width: 6px; height: 6px; background: #a5f3fc; border-radius: 50%; }
    .hero-title {
      font-family: 'Syne', sans-serif; font-size: 30px; font-weight: 800;
      color: #fff; line-height: 1.25; margin-bottom: 8px; position: relative; z-index: 1;
    }
    .hero-title span { color: #fde68a; }
    .hero-sub {
      font-size: 14px; color: rgba(255,255,255,0.72);
      font-weight: 400; line-height: 1.6; position: relative; z-index: 1;
    }

    .card-body { padding: 40px 48px; }

    .section-label {
      font-size: 11px; font-weight: 700; letter-spacing: 0.14em;
      text-transform: uppercase; color: #5eafc6; margin-bottom: 12px;
    }

    .rx-wrapper {
      background: #f0f9ff; border: 2px dashed #bae6fd;
      border-radius: 16px; padding: 20px 32px; text-align: center; margin-bottom: 20px;
    }
    .rx-id {
      font-family: 'Syne', sans-serif; font-size: 20px; font-weight: 800;
      letter-spacing: 0.06em; color: #0f3460;
    }
    .rx-hint { margin-top: 6px; font-size: 12px; color: #7dd3fc; font-weight: 500; }

    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px; }
    .info-tile { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px 16px; }
    .info-tile-label {
      font-size: 10px; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.1em; color: #94a3b8; margin-bottom: 4px;
    }
    .info-tile-value { font-size: 13px; font-weight: 600; color: #1e293b; }
    .info-tile-sub { font-size: 11px; color: #94a3b8; margin-top: 2px; }

    .date-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px; }
    .date-tile {
      display: flex; align-items: center; gap: 10px;
      background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 12px; padding: 12px 14px;
    }
    .date-tile.orange { background: #fff7ed; border-color: #fed7aa; }
    .date-icon {
      width: 32px; height: 32px; border-radius: 8px; background: #dcfce7;
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .date-tile.orange .date-icon { background: #ffedd5; }
    .date-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #4ade80; }
    .date-tile.orange .date-label { color: #fb923c; }
    .date-value { font-size: 12px; font-weight: 600; color: #166534; margin-top: 2px; }
    .date-tile.orange .date-value { color: #c2410c; }

    .issued-row {
      display: flex; align-items: center; gap: 10px;
      background: #f8f7ff; border: 1px solid #e0e7ff;
      border-radius: 12px; padding: 12px 16px; margin-bottom: 20px;
    }
    .issued-icon {
      width: 32px; height: 32px; background: #ede9fe; border-radius: 8px;
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .issued-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #a78bfa; }
    .issued-value { font-size: 12px; font-weight: 600; color: #4c1d95; margin-top: 2px; }

    .divider {
      height: 1px; background: linear-gradient(to right, transparent, #e0e7ff, transparent);
      margin: 4px 0 24px;
    }

    .instructions-box {
      background: #f8f7ff; border: 1px solid #e0e7ff;
      border-radius: 14px; padding: 20px 24px; margin-bottom: 20px;
    }
    .instructions-text { font-size: 13px; color: #374151; line-height: 1.9; white-space: pre-line; }

    .pdf-box {
      background: #fefce8; border: 1px solid #fde68a;
      border-radius: 14px; padding: 20px 24px; text-align: center; margin-bottom: 20px;
    }
    .pdf-box p { font-size: 13px; color: #854d0e; margin-bottom: 14px; line-height: 1.6; }
    .pdf-btn {
      display: inline-block;
      background: linear-gradient(135deg, #0f3460, #16a085);
      color: #fff; font-size: 13px; font-weight: 600;
      padding: 11px 28px; border-radius: 10px;
      text-decoration: none; letter-spacing: 0.02em;
    }

    .warn-box {
      display: flex; gap: 14px;
      background: #fff1f2; border: 1px solid #fecdd3;
      border-radius: 12px; padding: 16px 20px;
    }
    .warn-text { font-size: 13px; color: #9f1239; line-height: 1.65; }
    .warn-text strong { font-weight: 600; }

    .card-footer {
      background: #fafafa; border-top: 1px solid #f0f0f0;
      padding: 24px 48px; display: flex; align-items: center;
      justify-content: space-between; gap: 16px; flex-wrap: wrap;
    }
    .footer-text { font-size: 12px; color: #9ca3af; line-height: 1.6; }
    .footer-links { display: flex; gap: 16px; }
    .footer-links a { font-size: 12px; color: #7dd3fc; text-decoration: none; font-weight: 500; }

    .outer-note { text-align: center; margin-top: 24px; font-size: 11px; color: #9ca3af; }
  </style>
</head>
<body>
  <div class="wrapper">

    <!-- Brand -->
    <div class="brand">
      <div class="brand-logo">
        <div class="brand-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z" stroke="#fff" stroke-width="1.8"/>
            <path d="M12 8v4l3 3" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </div>
        <span class="brand-name">PH Healthcare</span>
      </div>
    </div>

    <div class="card">

      <!-- Hero -->
      <div class="card-hero">
        <div class="hero-tag">
          <span class="hero-dot"></span>
          Medical Prescription
        </div>
        <div class="hero-title">Dear, <span><%= patientName %></span> 👋</div>
        <p class="hero-sub">
          Dr. <%= doctorName %> has issued a new prescription for you.<br/>
          Please review the details and follow all instructions carefully.
        </p>
      </div>

      <!-- Body -->
      <div class="card-body">

        <!-- Prescription ID -->
        <div class="section-label">Prescription Reference</div>
        <div class="rx-wrapper">
          <div class="rx-id">#<%= prescriptionId %></div>
          <div class="rx-hint">Keep this ID for your records</div>
        </div>

        <!-- Doctor & Patient -->
        <div class="section-label">Parties Involved</div>
        <div class="info-grid">
          <div class="info-tile">
            <div class="info-tile-label">Doctor</div>
            <div class="info-tile-value">Dr. <%= doctorName %></div>
            <div class="info-tile-sub"><%= specialization %></div>
          </div>
          <div class="info-tile">
            <div class="info-tile-label">Patient</div>
            <div class="info-tile-value"><%= patientName %></div>
          </div>
        </div>

        <!-- Dates -->
        <div class="section-label">Dates</div>
        <div class="date-grid">
          <div class="date-tile">
            <div class="date-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <rect x="3" y="4" width="18" height="18" rx="3" stroke="#16a34a" stroke-width="1.8"/>
                <path d="M16 2v4M8 2v4M3 10h18" stroke="#16a34a" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </div>
            <div>
              <div class="date-label">Appointment</div>
              <div class="date-value"><%= appointmentDate %></div>
            </div>
          </div>
          <% if (followUpDate) { %>
          <div class="date-tile orange">
            <div class="date-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="9" stroke="#f97316" stroke-width="1.8"/>
                <path d="M12 7v5l3 3" stroke="#f97316" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </div>
            <div>
              <div class="date-label">Follow-up</div>
              <div class="date-value"><%= followUpDate %></div>
            </div>
          </div>
          <% } %>
        </div>

        <!-- Issued date -->
        <div class="issued-row">
          <div class="issued-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
              <path d="M12 2L2 7l10 5 10-5-10-5z" stroke="#7c3aed" stroke-width="1.8" stroke-linejoin="round"/>
              <path d="M2 17l10 5 10-5M2 12l10 5 10-5" stroke="#7c3aed" stroke-width="1.8" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <div class="issued-label">Issued On</div>
            <div class="issued-value"><%= issuedDate %></div>
          </div>
        </div>

        <div class="divider"></div>

        <!-- Instructions -->
        <div class="section-label">Instructions / Medications</div>
        <div class="instructions-box">
          <p class="instructions-text"><%= instructions %></p>
        </div>

        <!-- PDF Download -->
        <% if (pdfUrl) { %>
        <div class="pdf-box">
          <p>
            Your prescription PDF has been generated and attached to this email.<br/>
            You can also download it anytime using the button below.
          </p>
          <a href="<%= pdfUrl %>" class="pdf-btn">&#8681; Download Prescription PDF</a>
        </div>
        <% } %>

        <!-- Warning -->
        <div class="warn-box">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" style="flex-shrink:0;margin-top:1px">
            <path d="M10 2L2 17h16L10 2z" stroke="#f43f5e" stroke-width="1.6" stroke-linejoin="round"/>
            <path d="M10 8v4" stroke="#f43f5e" stroke-width="1.6" stroke-linecap="round"/>
            <circle cx="10" cy="14.5" r="0.75" fill="#f43f5e"/>
          </svg>
          <p class="warn-text">
            <strong>Important:</strong> This prescription is intended solely for <strong><%= patientName %></strong>.
            Follow all instructions carefully. If you experience any adverse effects, contact your doctor immediately.
          </p>
        </div>

      </div>

      <!-- Footer -->
      <div class="card-footer">
        <p class="footer-text">
          © 2025 PH Healthcare · Confidential Medical Document<br/>
          123 Health Avenue, Dhaka, Bangladesh
        </p>
        <div class="footer-links">
          <a href="#">Help</a>
          <a href="#">Privacy</a>
          <a href="#">Contact</a>
        </div>
      </div>

    </div>

    <p class="outer-note">This is an automated message. Please do not reply to this email.</p>

  </div>
</body>
</html>